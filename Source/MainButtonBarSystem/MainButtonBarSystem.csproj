<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RimWorld 1.7 (Waylith) runs on .NET 10 CoreCLR. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MainButtonBarSystem</RootNamespace>
    <AssemblyName>MainButtonBarSystem</AssemblyName>
    <!-- Build straight into the mod's version folder so the repo itself is the mod folder. -->
    <OutputPath>../../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Compile-time references only: nothing from these packages may be copied into 1.7/Assemblies. -->
  <ItemGroup>
    <!-- 1.7.4995 matches the game build on Steam's unstable branch. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- 0Harmony 3.0.0.0 is supplied at runtime by the Harmony mod (brrainz.harmony). -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
