    <moreButton>MBBSExample/ThemePack/Ember/More</moreButton>
    <arrowLeft>MBBSExample/ThemePack/Ember/ArrowLeft</arrowLeft>
    <arrowRight>MBBSExample/ThemePack/Ember/ArrowRight</arrowRight>
    <drawerBackground>MBBSExample/ThemePack/Ember/Drawer</drawerBackground>
    <drawerSettingsIcon>MBBSExample/ThemePack/Ember/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>
