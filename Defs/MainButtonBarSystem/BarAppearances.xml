<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Built-in appearance. Add-ons can add their own BarAppearanceDef with a custom workerClass. -->
  <MainButtonBarSystem.BarAppearanceDef>
    <defName>Vanilla</defName>
    <label>vanilla</label>
    <description>The game's own button look.</description>
    <workerClass>MainButtonBarSystem.BarAppearanceWorker</workerClass>
    <displayOrder>0</displayOrder>
  </MainButtonBarSystem.BarAppearanceDef>

  <!-- Built-in themes. Textures are drawn by tools/gen_theme_textures.py from colours measured from each expansion's
       logo and art and the game's data (docs/research/dlc-visuals-2026-11-04.md); no art is copied. They also serve
       as examples for theme mods (docs/API.md section 4). -->
  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Imperial</defName>
    <label>imperial</label>
    <description>Navy and gold with crowned corners and a psy-teal glow, from the Royalty expansion's colours.</description>
    <author>NAI</author>
    <displayOrder>10</displayOrder>
    <button>MainButtonBarSystem/Themes/Imperial/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Imperial/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Imperial/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Imperial/ButtonDisabled</buttonDisabled>
    <labelColor>(0.85, 0.85, 0.75, 1)</labelColor>
    <labelMouseoverColor>(0.96, 0.90, 0.46, 1)</labelMouseoverColor>
    <barBackground>MainButtonBarSystem/Themes/Imperial/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Imperial/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/Imperial/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/Imperial/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/Imperial/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Imperial/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>

  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Creed</defName>
    <label>creed</label>
    <description>Deep teal with coral borders and gold roundels, from the Ideology expansion's colours.</description>
    <author>NAI</author>
    <displayOrder>20</displayOrder>
    <button>MainButtonBarSystem/Themes/Creed/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Creed/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Creed/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Creed/ButtonDisabled</buttonDisabled>
    <labelColor>(0.97, 0.71, 0.69, 1)</labelColor>
    <labelMouseoverColor>(0.94, 0.78, 0.43, 1)</labelMouseoverColor>
    <barBackground>MainButtonBarSystem/Themes/Creed/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Creed/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/Creed/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/Creed/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/Creed/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Creed/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>

  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_GeneLab</defName>
    <label>gene lab</label>
    <description>Teal-blue with teal borders, deep red gene tiles and pale teal labels, from the Biotech expansion's colours.</description>
    <author>NAI</author>
    <displayOrder>30</displayOrder>
    <button>MainButtonBarSystem/Themes/GeneLab/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/GeneLab/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/GeneLab/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/GeneLab/ButtonDisabled</buttonDisabled>
    <labelColor>(0.72, 0.90, 0.91, 1)</labelColor>
    <labelMouseoverColor>(0.90, 0.97, 0.97, 1)</labelMouseoverColor>
    <barBackground>MainButtonBarSystem/Themes/GeneLab/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/GeneLab/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/GeneLab/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/GeneLab/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/GeneLab/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/GeneLab/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>

  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Void</defName>
    <label>void</label>
    <description>Void black with sage-green borders, a thin red line that glows under the mouse, and shard-cut corners, from the Anomaly expansion's colours.</description>
    <author>NAI</author>
    <displayOrder>40</displayOrder>
    <button>MainButtonBarSystem/Themes/Void/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Void/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Void/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Void/ButtonDisabled</buttonDisabled>
    <labelColor>(0.80, 0.84, 0.64, 1)</labelColor>
    <labelMouseoverColor>(0.96, 0.96, 0.88, 1)</labelMouseoverColor>
    <barBackground>MainButtonBarSystem/Themes/Void/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Void/More</moreButton>
