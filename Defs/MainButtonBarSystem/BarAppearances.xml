    <drawerBackground>MainButtonBarSystem/Themes/Void/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Void/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>

  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Starfarer</defName>
    <label>starfarer</label>
    <description>Space purple with purple hull plates, cyan rivets and a cyan thruster line, from the Odyssey expansion's colours.</description>
    <author>NAI</author>
    <displayOrder>50</displayOrder>
    <button>MainButtonBarSystem/Themes/Starfarer/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Starfarer/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Starfarer/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Starfarer/ButtonDisabled</buttonDisabled>
    <labelColor>(0.88, 0.84, 0.97, 1)</labelColor>
    <labelMouseoverColor>(0.71, 0.97, 0.99, 1)</labelMouseoverColor>
    <barBackground>MainButtonBarSystem/Themes/Starfarer/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Starfarer/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/Starfarer/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/Starfarer/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/Starfarer/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Starfarer/Gear</drawerSettingsIcon>
  </MainButtonBarSystem.BarAppearanceDef>

  <!-- Nai: the author's character, anime style, in the colours of her character sheet: a translucent portrait behind
       the left end of the bar, growing upwards out of it. The portrait is interim art cut from an existing illustration
       (tools/themes/Nai/Portrait_interim.png, drawn into the texture by tools/make_theme.py from tools/themes/Nai.json;
       keep this def in step with that file). Also the built-in example of a decoration and labelActiveColor
       (docs/API.md section 4); the full set of illustration fields is shown by docs/examples/ExampleTheme. -->
  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Nai</defName>
    <label>nai</label>
    <description>Anime-style theme in Nai's colours: deep navy buttons with grey-white borders, graphite lines and a violet glow, and a translucent character illustration behind the left end of the bar.</description>
    <author>NAI</author>
    <displayOrder>60</displayOrder>
    <button>MainButtonBarSystem/Themes/Nai/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Nai/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Nai/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Nai/ButtonDisabled</buttonDisabled>
    <labelColor>(0.96, 0.95, 0.94, 1)</labelColor>
    <labelMouseoverColor>(0.80, 0.72, 0.92, 1)</labelMouseoverColor>
    <labelActiveColor>(0.93, 0.90, 1, 1)</labelActiveColor>
    <barBackground>MainButtonBarSystem/Themes/Nai/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Nai/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/Nai/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/Nai/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/Nai/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Nai/Gear</drawerSettingsIcon>
    <decorations>
      <!-- The character, half transparent, behind the buttons, growing upwards out of the bar from its left end.
           Players can change the opacity, size and position in the Appearance tab. -->
      <li>
        <texture>MainButtonBarSystem/Themes/Nai/Portrait</texture>
        <anchor>Left</anchor>
        <verticalAnchor>Bottom</verticalAnchor>
        <opacity>0.45</opacity>
        <layer>BelowButtons</layer>
      </li>
    </decorations>
  </MainButtonBarSystem.BarAppearanceDef>
</Defs>
