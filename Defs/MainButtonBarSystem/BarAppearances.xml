  <!-- Nai: the author's character as pixel art, in the colours of her character sheet. Vanilla-style hollow frames
       (palette frame "vanilla" in tools/themes/Nai.json) and a picture inside every main button, chosen by what the button
       does: Nai holding up a matching item for buttons that have an icon (chest_*, anchored left so the icon and label sit to
       her right), Nai peeking from behind a blackboard for buttons without one (board_*, centred so the label sits on the
       board). Buttons not listed get the plain blackboard (buttonImage). Textures are drawn into Textures/ by
       tools/gen_theme_textures.py from tools/themes/Nai.json and the pictures in tools/themes/Nai/Buttons/; keep this def in
       step with that file. Also the built-in example of buttonImage / buttonImages and labelActiveColor (docs/API.md
       section 4); the full set of illustration fields is shown by docs/examples/ExampleTheme. -->
  <MainButtonBarSystem.BarAppearanceDef>
    <defName>MBBS_Nai</defName>
    <label>nai</label>
    <description>Pixel-art theme with Nai: vanilla-style frames and a picture of Nai inside every main button. On buttons with an icon she holds up an item that matches the button (a blueprint, a flask, a medkit...); on buttons without one she peeks out from behind a blackboard that the label sits on. Pictures are set for the base game's and expansions' buttons and for many mods' buttons; any other button gets the blackboard. Looks best in the Scroll or Collapse + scroll display modes with buttons at least 120 px wide.</description>
    <author>NAI</author>
    <displayOrder>60</displayOrder>
    <button>MainButtonBarSystem/Themes/Nai/Button</button>
    <buttonMouseover>MainButtonBarSystem/Themes/Nai/ButtonMouseover</buttonMouseover>
    <buttonActive>MainButtonBarSystem/Themes/Nai/ButtonActive</buttonActive>
    <buttonDisabled>MainButtonBarSystem/Themes/Nai/ButtonDisabled</buttonDisabled>
    <labelColor>(0.96, 0.95, 0.94, 1)</labelColor>
    <labelMouseoverColor>(0.80, 0.72, 0.92, 1)</labelMouseoverColor>
    <labelActiveColor>(0.93, 0.90, 1, 1)</labelActiveColor>
    <barBackground>MainButtonBarSystem/Themes/Nai/Bar</barBackground>
    <moreButton>MainButtonBarSystem/Themes/Nai/More</moreButton>
    <arrowLeft>MainButtonBarSystem/Themes/Nai/ArrowLeft</arrowLeft>
    <arrowRight>MainButtonBarSystem/Themes/Nai/ArrowRight</arrowRight>
    <drawerBackground>MainButtonBarSystem/Themes/Nai/Drawer</drawerBackground>
    <drawerSettingsIcon>MainButtonBarSystem/Themes/Nai/Gear</drawerSettingsIcon>
    <!-- The pictures need about 120px: the Appearance tab offers this layout (applied only when the player presses its button). -->
    <suggestedLayout>
      <displayModes>
        <li>Scroll</li>
        <li>CollapseScroll</li>
      </displayModes>
      <buttonWidth>120</buttonWidth>
      <halfButtonsFullWidth>true</halfButtonsFullWidth>
    </suggestedLayout>
    <!-- The plain blackboard for every button not listed below. -->
    <buttonImage>
      <texture>MainButtonBarSystem/Themes/Nai/Btn_board_plain</texture>
    </buttonImage>
    <!-- One picture per button (button = the MainButtonDef's defName). Buttons of mods that are not loaded are
         skipped. Fit Cover and vertical anchor Center are the defaults. -->
