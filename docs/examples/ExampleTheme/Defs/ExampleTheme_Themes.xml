<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Generated by make_theme.py from ExampleTheme.json. Texture paths are relative to Textures/, without the extension. -->
  <MainButtonBarSystem.BarAppearanceDef>
    <defName>ExampleTheme_Steel</defName>
    <label>example steel</label>
    <description>Brushed steel with amber labels. An example theme that uses every field; the illustrations are placeholders.</description>
    <author>Your name</author>
    <displayOrder>100</displayOrder>

    <!-- Button atlases (nine-slice, square, 64x64 here) and label colours per state. -->
    <button>ExampleTheme/Button</button>
    <buttonMouseover>ExampleTheme/ButtonMouseover</buttonMouseover>
    <buttonActive>ExampleTheme/ButtonActive</buttonActive>
    <buttonDisabled>ExampleTheme/ButtonDisabled</buttonDisabled>
    <labelColor>(1, 0.8, 0.4, 1)</labelColor>
    <labelMouseoverColor>(1, 0.95, 0.7, 1)</labelMouseoverColor>
    <labelActiveColor>(1, 1, 0.85, 1)</labelActiveColor>

    <!-- Bar and drawer backgrounds. Fit: Atlas (nine-slice, default) / Tile / Stretch / Fit / Cover. -->
    <barBackground>ExampleTheme/Bar</barBackground>
    <barBackgroundFit>Stretch</barBackgroundFit>
    <barBackgroundTileScale>1</barBackgroundTileScale>
    <drawerBackground>ExampleTheme/Drawer</drawerBackground>
    <drawerBackgroundFit>Atlas</drawerBackgroundFit>
    <drawerBackgroundTileScale>1</drawerBackgroundTileScale>

    <moreButton>ExampleTheme/More</moreButton>
    <arrowLeft>ExampleTheme/ArrowLeft</arrowLeft>
    <arrowRight>ExampleTheme/ArrowRight</arrowRight>
    <drawerSettingsIcon>ExampleTheme/Gear</drawerSettingsIcon>
    <preview>ExampleTheme/Preview</preview>

    <!-- Decorations: any image at an anchor of the bar or the drawer, below or above the buttons. -->
    <decorations>
      <li>
        <texture>ExampleTheme/Portrait</texture>
        <target>Bar</target>
        <anchor>Left</anchor>
        <verticalAnchor>Bottom</verticalAnchor>
        <offset>(0, 0)</offset>
        <size>(0, 0)</size>
        <opacity>1</opacity>
        <layer>BelowButtons</layer>
      </li>
      <li>
        <texture>ExampleTheme/HoverBadge</texture>
        <target>Bar</target>
        <anchor>Right</anchor>
        <verticalAnchor>Bottom</verticalAnchor>
        <offset>(-8, -40)</offset>
        <size>(0, 0)</size>
        <opacity>0.9</opacity>
        <layer>AboveButtons</layer>
        <showWhen><li>Mouseover</li><li>DrawerOpen</li></showWhen>
      </li>
      <li>
        <texture>ExampleTheme/DrawerBadge</texture>
        <target>Drawer</target>
        <anchor>Right</anchor>
        <verticalAnchor>Top</verticalAnchor>
        <offset>(-4, 4)</offset>
        <size>(0, 0)</size>
        <opacity>1</opacity>
        <layer>AboveButtons</layer>
      </li>
    </decorations>
  </MainButtonBarSystem.BarAppearanceDef>
</Defs>
